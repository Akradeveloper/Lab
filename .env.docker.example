# =============================================================================
# Variables de entorno para Docker (copiar a .env.docker y rellenar)
# NO commitear .env.docker — solo este .example va al repo
# =============================================================================

# ---- MySQL (contenedor db) ----
MYSQL_ROOT_PASSWORD=rootpass-cambiar
MYSQL_PASSWORD=qalab-pass-cambiar

# ---- Conexión de la app al MySQL local (contenedor db) ----
DATABASE_URL=mysql://qalab:qalab-pass-cambiar@db:3306/qalab
DB_SSL=false

# ---- NextAuth ----
NEXTAUTH_SECRET=cambiar-por-un-secreto-seguro
NEXTAUTH_URL=http://localhost:3000

# ---- Sandbox (ejecución de código de ejercicios CODE) ----
# URL del servicio sandbox (en Docker: http://sandbox:3001). Si no se define, la cola no se procesa.
# SANDBOX_URL=http://sandbox:3001
# Secreto para proteger POST /api/internal/process-queue (cron o worker). Si no se define, la ruta es abierta.
# PROCESS_QUEUE_SECRET=

# ---- Cloudflare Quick Tunnel ----
# No requiere token ni dominio. Al arrancar, el contenedor "tunnel"
# genera una URL publica temporal tipo https://algo.trycloudflare.com
# Consulta los logs del contenedor tunnel para ver la URL asignada.

# ---- OpenAI (opcional, para IA en admin) ----
OPENAI_API_KEY=sk-...

# ---- Cloudflare Turnstile (opcional, anti-bots en registro) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- SonarQube (contenedor sonar; opcional en producción) ----
# Contraseña de la base PostgreSQL usada por SonarQube. Por defecto "sonar".
# SONAR_DB_PASSWORD=sonar
